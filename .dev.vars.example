# Copy this file to `.dev.vars` (which is git-ignored) and fill in the values.
# In production, set the same names with `npx wrangler secret put NAME`.

# --- Required: the app runs with only these two ---
ANTHROPIC_API_KEY=sk-ant-...
ADMIN_PASSWORD=choose-a-long-password

# --- Optional Claude settings (defaults shown) ---
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=low
# CLAUDE_MAX_TOKENS=4000

# --- Real WhatsApp (leave blank to use only the /mock-wa simulator) ---
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# Comma-separated, international format without "+", e.g. 6591234567,6598765432
# ALLOWED_WHATSAPP_NUMBERS=

# --- WhatsApp through Twilio (alternative to Meta; leave blank to keep it off) ---
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=
# The WhatsApp sender, e.g. Twilio's sandbox number
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
